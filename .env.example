# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.
# Los valores están en Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secreta: nunca en el navegador ni en el repo. Solo la usa el servidor para crear cuentas de alumnos.
SUPABASE_SECRET_KEY=sb_secret_...
